# Database Connection (Neon Serverless PostgreSQL or local Postgres)
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/optical-pos?sslmode=require"

# Upstash Redis Cache (Optional: Falls back gracefully to direct DB queries if omitted)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Better Auth Configuration
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
# On local: http://localhost:3000
# On Vercel: https://your-app.vercel.app (auto-detected from VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL if omitted)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

