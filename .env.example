# Database Connection (Neon Serverless PostgreSQL or local Postgres)
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/optical-pos?sslmode=require"

# Upstash Redis Cache (Optional: Falls back gracefully to direct DB queries if omitted)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Better Auth Configuration
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
# On local: http://localhost:3000
# On Vercel: https://your-app.vercel.app (auto-detected from VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL if omitted)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 (Social Authentication)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gmail SMTP Mail Server Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false" # false for 587 (STARTTLS), true for 465 (SSL)
SMTP_USER="msanthosh9943@gmail.com"
SMTP_PASS="" # 16-character Google App Password
SMTP_FROM_EMAIL="msanthosh9943@gmail.com"
SMTP_FROM_NAME="OptixOS Eyecare"

# Platform Root Super Admin Allowlist (comma-separated list of authorized email addresses)
SUPER_ADMIN_EMAILS="msanthosh9943@gmail.com,varundinesh10@gmail.com"
# Super Admin One-Time Password (OTP) Lifetime in seconds (strictly enforced, e.g. 180 = 3 minutes)
SUPER_ADMIN_OTP_EXPIRY_SECONDS="180"
# Super Admin Session Lifetime in seconds (strictly enforced, e.g. 28800 = 8 hours, 3600 = 1 hour)
SUPER_ADMIN_SESSION_EXPIRY_SECONDS="28800"

# Organization / Store Identifier Prefix (e.g. OPT -> OPT-1, OPT-2; or STORE -> STORE-1)
ORG_CODE_PREFIX="OPT"

# Razorpay SaaS Payment Gateway (Subscriptions & Plan Upgrades)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
